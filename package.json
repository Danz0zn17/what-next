{
  "name": "whatnext-ai",
  "version": "2.5.4",
  "description": "What Next — AI-powered continuity engine. Your second brain that always knows what happened and what comes next.",
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "install-what-next": "bin/install.js",
    "wn": "bin/wn.js"
  },
  "scripts": {
    "start": "node src/cloud-server.js",
    "mcp": "node src/server.js",
    "mcp:http": "node src/http-mcp.js",
    "cloud": "node src/cloud-server.js",
    "api": "node bin/local-api.js",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --test --test-concurrency=1 --watch",
    "test:ci": "node --test --test-concurrency=1 --test-reporter=spec",
    "chatgpt:login": "node src/scrape-chatgpt.js --login",
    "chatgpt:scrape": "node src/scrape-chatgpt.js --scrape",
    "chatgpt:preview": "node src/scrape-chatgpt.js --scrape --dry-run",
    "backfill": "node src/backfill-embeddings.js",
    "dream": "node src/dream-cli.js",
    "dream:dry": "node src/dream-cli.js --dry-run",
    "postinstall": "node bin/check-onnx.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "pg": "^8.20.0",
    "playwright": "^1.58.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danz0zn17/what-next.git"
  }
}
